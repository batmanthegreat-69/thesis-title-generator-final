# Get a free key at https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# Check https://console.groq.com/docs/models for the current list —
# Groq periodically deprecates models. gpt-oss-120b is the current
# general-purpose recommendation as of late 2026.
GROQ_MODEL=openai/gpt-oss-120b

PORT=3000
